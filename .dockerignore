# Git
.git
.gitignore
.gitmodules

# Dependencies
node_modules
**/node_modules
.venv
**/.venv
.notebooklm-cli-venv/
.notebooklm-playwright/
.pip-cache/
.uv-cache/

# Built artifacts that are regenerated inside the image.  Excluded so local
# rebuilds on the developer's machine don't invalidate the npm-install layer
# that now depends on the full ui-tui/packages/hermes-ink/ tree being present.
ui-tui/dist/
ui-tui/packages/hermes-ink/dist/

# CI/CD
.github

# Environment files
.env

*.md

# Runtime data (bind-mounted at /opt/data; must not leak into build context)
data/
.hermes-docker/
.notebooklm-home/

# Compose/profile runtime state (bind-mounted; avoid ownership/secret issues)
hermes-config/
runtime/

# Local ~/.hermes backup tarballs (scripts/backup-hermes-home.sh). Operator
# data, not a build input — 1.6 GB of these were being baked into the image,
# bloating it and failing layer extraction on a constrained disk.
backups/
*.tar.gz

# Operator-local tooling / throwaway state — never build inputs.
.beads/
.great_cto/
*.bak-*
